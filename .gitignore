# Secrets (if ever generated locally)
.env
.env.local

# TLS/certificates
*.pem
*.key
*.crt
*.p12
*.pfx

# All service runtime data (add new services under services/ and this covers them)
services/*

# Exception: glance.yml is config we author, not runtime state the app mutates
!services/glance/
services/glance/*
!services/glance/config/
services/glance/config/*
!services/glance/config/glance.yml

# Exception: declarative *arr settings we export + author (quality profile, naming,
# media management, delay profile). NOT the runtime DB/config.xml (those stay ignored).
!services/sonarr/
services/sonarr/*
!services/sonarr/settings/

!services/radarr/
services/radarr/*
!services/radarr/settings/

# Exception: ntfy server.yml is config we author. The message cache + auth DB
# under services/ntfy/cache/ is runtime state — stays ignored.
!services/ntfy/
services/ntfy/*
!services/ntfy/config/
services/ntfy/config/*
!services/ntfy/config/server.yml

# Exception: the SMS bridge script + its opt-in notice are things we author. The
# SQLite session/dedupe DB under services/sms-bridge/data/ is runtime state — ignored.
!services/sms-bridge/
services/sms-bridge/*
!services/sms-bridge/bridge.py
!services/sms-bridge/OPT-IN.md
!services/sms-bridge/site/
!services/sms-bridge/site/*

# Exception: the Valheim egg JSON. Panel 1.x has no egg-import CLI and no API
# endpoint for it, so importing is a manual UI step and this file is the only
# record of what to re-import on a rebuild. Everything else under
# services/pterodactyl/ is runtime state and stays ignored — the panel's
# generated .env (holds APP_KEY), wings' config.yml (holds the node token) and
# the panel DB.
!services/pterodactyl/
services/pterodactyl/*
!services/pterodactyl/egg-valheim.json

# Exception: the join-code watcher script. The code it captures under
# services/valheim-joincode/www/ is runtime state and stays ignored.
!services/valheim-joincode/
services/valheim-joincode/*
!services/valheim-joincode/watch.py

# Same shape: services/valheim-autoupdate/state/ is runtime state and stays
# ignored; the script it runs is authored here.
!services/valheim-autoupdate/
services/valheim-autoupdate/*
!services/valheim-autoupdate/guard.py

# Media & downloads
media/
downloads/
photos/
roms/

# Logs
*.log
logs/

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*~
