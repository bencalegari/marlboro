# Secrets (if ever generated locally)
.env
.env.local

# TLS/certificates
*.pem
*.key
*.crt
*.p12
*.pfx

# All service runtime data (add new services under services/ and this covers them)
services/*

# Exception: glance.yml is config we author, not runtime state the app mutates
!services/glance/
services/glance/*
!services/glance/config/
services/glance/config/*
!services/glance/config/glance.yml

# Exception: declarative *arr settings we export + author (quality profile, naming,
# media management, delay profile). NOT the runtime DB/config.xml (those stay ignored).
!services/sonarr/
services/sonarr/*
!services/sonarr/settings/

!services/radarr/
services/radarr/*
!services/radarr/settings/

# Exception: ntfy server.yml is config we author. The message cache + auth DB
# under services/ntfy/cache/ is runtime state — stays ignored.
!services/ntfy/
services/ntfy/*
!services/ntfy/config/
services/ntfy/config/*
!services/ntfy/config/server.yml

# Exception: the SMS bridge script + its opt-in notice are things we author. The
# SQLite session/dedupe DB under services/sms-bridge/data/ is runtime state — ignored.
!services/sms-bridge/
services/sms-bridge/*
!services/sms-bridge/bridge.py
!services/sms-bridge/OPT-IN.md
!services/sms-bridge/site/
!services/sms-bridge/site/*

# Media & downloads
media/
downloads/
photos/
roms/

# Logs
*.log
logs/

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*~
